{
  "name": "paperquay",
  "private": true,
  "version": "0.4.42",
  "description": "AI-assisted desktop literature reader and library manager.",
  "author": {
    "name": "PaperQuay Developers",
    "email": "WangQrkkk@users.noreply.github.com"
  },
  "license": "AGPL-3.0-only",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "web:dev": "vite --host 127.0.0.1 --port 1420",
    "dev": "node scripts/bundle-preload.cjs && node electron/dev.cjs",
    "electron:dev": "node scripts/bundle-preload.cjs && node electron/dev.cjs",
    "mcp": "node bin/paperquay-mcp.cjs",
    "mcp:bundle": "node scripts/bundle-mcp.cjs",
    "build": "node scripts/bundle-preload.cjs && npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.checkjs.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.tests.mjs.json",
    "test": "node --test \"tests/*.test.ts\" \"tests/*.test.mjs\"",
    "check": "npm run build && npm test",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "electron:build": "npm run build && node electron/build.cjs",
    "preload:bundle": "node scripts/bundle-preload.cjs",
    "lint": "eslint . --max-warnings 206"
  },
  "bin": {
    "paperquay-mcp": "./bin/paperquay-mcp.cjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.9",
    "eventsource-parser": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "sql.js": "^1.13.0",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.5",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-character-count": "^3.23.6",
    "@tiptap/extension-code-block-lowlight": "^3.23.6",
    "@tiptap/extension-drag-handle-react": "^3.23.6",
    "@tiptap/extension-highlight": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-mathematics": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-table": "^3.23.6",
    "@tiptap/extension-table-cell": "^3.23.6",
    "@tiptap/extension-table-header": "^3.23.6",
    "@tiptap/extension-table-row": "^3.23.6",
    "@tiptap/extension-task-item": "^3.23.6",
    "@tiptap/extension-task-list": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@tiptap/suggestion": "^3.23.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "app-builder-lib": "^26.8.1",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.1",
    "builder-util": "^26.8.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.0.12",
    "electron-winstaller": "^5.4.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "katex": "^0.16.11",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.8.0",
    "pdfjs-dist": "4.8.69",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-pdf": "9.2.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "resedit": "^1.7.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.0.14",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "dev.paperquay.app",
    "productName": "PaperQuay",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Dongyurocket",
        "repo": "PaperQuay",
        "releaseType": "release",
        "channel": "stable"
      }
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "packaging/mcp",
        "to": "paperquay-mcp",
        "filter": [
          "**/*",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "packaging/mcp/node_modules",
        "to": "paperquay-mcp/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/pdfjs-dist/cmaps",
        "to": "pdfjs/cmaps"
      },
      {
        "from": "node_modules/pdfjs-dist/standard_fonts",
        "to": "pdfjs/standard_fonts"
      },
      {
        "from": "node_modules/pdfjs-dist/image_decoders",
        "to": "pdfjs/image_decoders"
      },
      {
        "from": "node_modules/pdfjs-dist/legacy/build",
        "to": "pdfjs/legacy/build"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/sqlite-vec-*/**/*"
    ],
    "toolsets": {
      "winCodeSign": null
    },
    "electronFuses": {
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "afterPack": "electron/afterPack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/shared/**/*",
      "package.json",
      "node_modules/adm-zip/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/semver/**/*",
      "node_modules/sax/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/eventsource-parser/**/*",
      "node_modules/sql.js/**/*",
      "node_modules/sqlite-vec/**/*",
      "node_modules/sqlite-vec-*/*",
      "node_modules/pdf-lib/**/*",
      "node_modules/@pdf-lib/**/*",
      "node_modules/xmlbuilder/**/*",
      "!node_modules/canvas/**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PaperQuay",
      "include": "installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "maintainer": "PaperQuay Developers <WangQrkkk@users.noreply.github.com>",
      "category": "Office",
      "icon": "icon.png"
    }
  }
}
