{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["electron/**/*.cjs", "bin/**/*.cjs"],
  "exclude": ["node_modules", "dist", "release", "packaging"]
}
